{
  "name": "webminton",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "prettier --check packages frontend/public/tournament.json *.json *.yaml",
    "format": "prettier --write packages frontend/public/tournament.json *.json *.yaml",
    "build": "pnpm -r build",
    "test:e2e": "playwright test",
    "validate": "node --import tsx scripts/validate-tournament.ts",
    "dev": "pnpm --filter @webminton/frontend dev"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "prettier": "3.6.2",
    "@types/node": "24.10.1",
    "tsx": "4.23.13",
    "@playwright/test": "1.63.0"
  },
  "type": "module"
}
